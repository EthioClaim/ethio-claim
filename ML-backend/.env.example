ENVIRONMENT=development
INTERNAL_SERVICE_TOKEN=replace-with-secret
PORT=8000
HOST=0.0.0.0

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION=ethio_claim_evidence_v1

# Embedding and Model Settings
EMBEDDING_MODEL_NAME=ethio-vision-encoder
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_DIMENSION=128
DAMAGE_MODEL_PATH=/models/damage-model.pt
USE_MOCK_DAMAGE_MODEL=true
USE_MOCK_EMBEDDING_MODEL=true

# Operational Thresholds
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_DIMENSION=6000
ANALYSIS_TIMEOUT_SECONDS=30
TOP_K_DEFAULT=5

# Similarity Thresholds
EXACT_HASH_SIMILARITY_THRESHOLD=1.0
PERCEPTUAL_HASH_DISTANCE_THRESHOLD=8
VECTOR_SIMILARITY_FRAUD_THRESHOLD=0.85
VECTOR_SIMILARITY_SUSPICIOUS_THRESHOLD=0.85

LOCAL_UPLOADS_DIR=../ethioclaim-backend/uploads
